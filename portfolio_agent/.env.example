# ── Upstox ────────────────────────────────────────────
UPSTOX_CLIENT_ID=your_upstox_client_id
UPSTOX_CLIENT_SECRET=your_upstox_client_secret
UPSTOX_REDIRECT_URI=http://localhost:8000/callback
UPSTOX_ACCESS_TOKEN=              # filled after first OAuth login

# Upstox auto token refresh (for upstox_auth.py)
UPSTOX_MOBILE=your_10_digit_mobile_number
UPSTOX_PIN=your_6_digit_upstox_pin
UPSTOX_TOTP_SECRET=               # optional — only if you enabled TOTP in Upstox app

# ── Vested ────────────────────────────────────────────
VESTED_EMAIL=your_vested_email@example.com
VESTED_PASSWORD=your_vested_password

# ── Anthropic (Claude) ────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Email Alerts ──────────────────────────────────────
ALERT_FROM_EMAIL=your_gmail@gmail.com
ALERT_FROM_PASSWORD=your_gmail_app_password   # Use Gmail App Password, not your real password
ALERT_TO_EMAIL=kthomas488@gmail.com

# ── Monitoring Schedule ───────────────────────────────
# How often to run the check (in hours)
CHECK_INTERVAL_HOURS=8
